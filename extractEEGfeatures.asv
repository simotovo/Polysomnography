function featureEEG = extractEEGfeatures(freq, eeg)
    %INPUT:
    %   freq: frequency array (1 x n)
    %   eeg: cell (epochs x channels) with arrays of signals
    % OUTPUT:
    %   featureEEG: table (epochs x features)

    %Calculating band powers
    transformedEEG = transform(eeg);
    bands = {'deltaLow', 'delta', 'theta', 'alfa', 'sigma', 'beta'};
    bandLimits = [0.3 1; 1 4; 4 8; 8 12; 12 15; 15 30];
    labels = {'EEGFpz_Cz', 'EEGPz_Oz'};
    bandTable = calculateBandPowers(freq, transformedEEG, labels, bands, bandLimits, true);
    
    %Band powers mean
    delta  = mean([bandTable.EEGFpz_Cz_delta, bandTable.EEGPz_Oz_delta], 2);
    theta  = mean([bandTable.EEGFpz_Cz_theta, bandTable.EEGPz_Oz_theta], 2);
    alfa   = mean([bandTable.EEGFpz_Cz_alfa,  bandTable.EEGPz_Oz_alfa],  2);
    sigma  = mean([bandTable.EEGFpz_Cz_sigma, bandTable.EEGPz_Oz_sigma], 2);
    beta   = mean([bandTable.EEGFpz_Cz_beta,  bandTable.EEGPz_Oz_beta],  2);
    
    %Additional features
    theta_alpha_ratio = theta ./ (alfa + eps);
    sigma_delta_ratio = sigma ./ (delta + eps);
    alpha_beta_ratio = alfa ./ (beta + eps);
    delta_rel_ratio = delta ./ (alfa + beta + eps);
    total_power = delta + theta + alfa + sigma + beta;
    
    colNames = {'EEG_theta_alpha_ratio','EEG_sigma_delta_ratio','EEG_alpha_beta_ratio','EEG_delta_rel_ratio','EEG_total_power'};
    derivedTable = table(theta_alpha_ratio, sigma_delta_ratio,alpha_beta_ratio, delta_rel_ratio, total_power, ...
        'VariableNames', colNames);

    featureEEG = [bandTable derivedTable];
end
