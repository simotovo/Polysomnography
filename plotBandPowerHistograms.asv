function plotBandPowerHistograms(bandPowers, label)
    % bandPowers: table (signals x bandPowers) with arrays of signals 
    % label: cell (1 x signals) with the names of the signals
    
    numSignals = size(bandPowers, 1);
    
    bandNames = bandPowers.Properties.VariableNames(2:end);
    
    for i = 1:numSignals
        bandPowerValues = bandPowers{i, 2:end};
        yLimits(i) = max(bandPowerValues);
    end

    y_max = ceil(max(yLimits));
    
    %Bar plotting
    for i = 1:numSignals
        bandPowerValues = bandPowers{i, 2:end};
        figure
        bar(bandPowerValues);
        title(['Potenza spettrale per ' label{i}]);
        set(gca, 'xticklabel', bandNames);
        xlabel('Bande di frequenza [Hz]');
        ylabel('Potenza [microV^2]');
        grid on;
        ylim([0, y_max]);
        
        %Save figure
        %label{i} = strrep(label{i}, ' ', '_'); %
        %filename = sprintf('Bande_di_potenza.jpg', label{i}); % Nome dinamico con indice del ciclo
        %exportgraphics(gcf, filename, 'Resolution', 300);
    end
end
